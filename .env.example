# AAROH: environment variable NAMES ONLY. Never put real values in this file.
# Real values go in an untracked file (.env, .env.local) or your shell. See README.md.
#
# Names below come from the code that actually reads them:
#   server/   reads process.env directly (no dotenv loader), so export these in your shell
#   ai/       Next.js reads ai/.env.local (the authoritative list is ai/.env.example)
#   frontend/ reads none yet (it runs on its mock backend)

# ── server/ (Member 3: Express + SQLite via Drizzle) ───────────────────────────
PORT=
DATABASE_PATH=

# ── ai/ (Member 1: Next.js AI API routes) ──────────────────────────────────────
# Supabase (browser-safe public values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Gemini: SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=
