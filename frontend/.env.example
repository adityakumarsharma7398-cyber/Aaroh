# AAROH frontend: environment variable NAMES ONLY. Copy to .env.local (ignored by git) and fill in.
# Never commit real values.

# Where the backend REST API lives (Member 3's Express server). Example for local development:
#   http://localhost:3001/api
VITE_API_BASE_URL=

# DEVELOPMENT ONLY. The backend currently resolves `Authorization: Bearer <profile id>` against its
# profiles table (a development stand-in for real authentication). Seeded student ids: see server/API.md.
# This is set in one place (src/services/apiClient.ts). Remove it once real auth exists.
VITE_DEV_AUTH_TOKEN=
